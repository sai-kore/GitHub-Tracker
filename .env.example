PORT=5000
MONGODB_URI=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
SYNC_SECRET=

# Account (organization or user) whose repos you want to track
GITHUB_OWNER=

# Which repos to track:
#   *                        -> every repo in the account (default, auto-discovers new repos)
#   repo1,repo2,owner/repo3  -> only these
GITHUB_REPOS=*

# Optional
GITHUB_EXCLUDE_REPOS=
GITHUB_INCLUDE_FORKS=false
GITHUB_INCLUDE_ARCHIVED=false

# Background sync every N minutes (0 = disable). Webhooks give instant updates,
# this is the safety net that guarantees nothing is ever missed.
SYNC_INTERVAL_MINUTES=10

# OAuth login (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
AUTH_SUCCESS_REDIRECT=/
